# ============================================
# article-agent 配置
# 复制此文件为 .env 并修改：cp .env.example .env
# ============================================

# 默认语气：严谨 | 专业 | 俏皮
# 留空 = 按内容自动判断（推荐）
DEFAULT_TONE=

# 是否启用飞书模式（true / false，留空 = 关闭）
# true  → 全过程归档到 FEISHU_WIKI_ID 知识库，支持跨 session / 跨机器续接
# false → 仅本地 output/ 落盘
USE_FEISHU=

# 飞书知识库（空间）ID（USE_FEISHU=true 时必填）
FEISHU_WIKI_ID=

# 产出目录（相对于 article-agent/）
OUTPUT_DIR=output
