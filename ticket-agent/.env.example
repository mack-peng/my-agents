# Ticket Agent 环境配置
# 复制此文件为 .env 并填入实际路径

# Bobcat 仓库本地路径
BOBKAT_PATH=/path/to/Bobcat

# Component Kit 仓库本地路径（可选）
COMPONENT_KIT_PATH=/path/to/component-kit

# 是否启用飞书文档持久化（true/false）
# true: 进度存飞书文档，支持跨 session 续接
# false: 进度仅在当前 session 对话中流转
USE_FEISHU=true

# 飞书知识库 Space ID（仅 USE_FEISHU=true 时需要）
FEISHU_WIKI_ID=
