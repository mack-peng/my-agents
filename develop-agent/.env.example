# ============================================
# develop-agent 环境配置
# 复制此文件为 .env 并填入实际值
# ============================================

# 是否启用飞书文档持久化（true / false）
# true: 跨 session / 跨机器续接，进度写入飞书知识库
# false: 单 session 对话内完成，不需要 feishu-agent
USE_FEISHU=true

# Develop 知识库 Space ID（任务管理层：进度追踪、SOP ref、全流程记录）
FEISHU_DEVELOP_WIKI_ID=<your_develop_wiki_id>

# Spec 知识库 Space ID（Phase 1 Design 输出归档位置）
FEISHU_SPEC_WIKI_ID=<your_spec_wiki_id>

# Code Design 知识库 Space ID（Phase 2 Code Design 输出归档位置）
FEISHU_CODE_DESIGN_WIKI_ID=<your_code_design_wiki_id>
