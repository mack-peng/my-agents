# research-agent 配置
# 复制此文件为 .env 并修改

# 深度调研最少搜索轮数（不足该轮数不结束；此后 LLM 每轮评估是否继续，信息不足则追加搜索，无硬性上限）
DEFAULT_DEPTH=3

# 搜索决策 LLM 温度（低温度保证决策精确，取值范围 0-1）
SEARCH_DECISION_TEMPERATURE=0.3

# 报告生成 LLM 温度（高温度增强可读性和创造性，取值范围 0-1）
REPORT_TEMPERATURE=0.7

# 每轮搜索从结果中抓取的文章数（至少 5 篇）
MAX_RESULTS_PER_QUERY=5

# Google 搜索引擎首页（如需其他地区可用 .google.co.jp 等）
SEARCH_ENGINE_URL=https://www.google.com

# 报告输出目录（相对于 research-agent/，飞书模式下仍保留本地 .md）
# 封面/插图直接存本目录、与 .md/.docx 同级别
REPORT_OUTPUT_DIR=output

# 是否启用飞书模式（true/false，默认空 = 关闭 → 走本地分支）
# true → 调研报告在 FEISHU_WIKI_ID 知识库内建立为飞书文档
USE_FEISHU=

# 飞书知识库（空间）ID（USE_FEISHU=true 时报告文档的落点）
FEISHU_WIKI_ID=

# 搜索执行方选择（true/false，推荐 true）
# true  → 委托 firecrawl-agent（搜索+抓取一步完成）
# false → 委托 browser-agent（浏览器搜索 + webfetch 抓取）
USE_FIRECRAWL=true
